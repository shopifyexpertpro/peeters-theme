

{% liquid 
assign sub_title = block.settings.sub_title
assign title = block.settings.title
assign content = block.settings.content
assign btn_text = block.settings.btn_text
assign btn_url= block.settings.btn_url
assign button_style = block.settings.button_style


assign block_width = block.settings.block_width
assign block_width_phone = block.settings.block_width_phone
assign title_max_width = block.settings.title_max_width
assign title_size = block.settings.title_size
assign title_margin_bottom = block.settings.title_margin_bottom
assign content_max_width = block.settings.content_max_width
assign block_padding_horizontal = block.settings.block_padding_horizontal
assign block_padding_vertical = block.settings.block_padding_vertical
assign color_scheme = block.settings.color_scheme


assign logo = block.settings.logo
assign reviews_text = block.settings.reviews_text
assign reviews_rating = block.settings.reviews_rating


%}




<div class="color-{{ color_scheme }} gradient title_style">
    <div class="title_content_left">
        {%  unless sub_title == blank %} <h5>{{ sub_title }}</h5>  {% endunless %} 
         {%  unless title == blank   %} <h2 class="title_{{title_size}}">{{ title }}</h2>  {% endunless %}
         {%  unless content == blank  %} <div class="content">{{ content }}</div>  {% endunless %} 
    
         {%  render 'btn', 
                btn_text:btn_text, 
                btn_url:btn_url, 
                button_style:button_style
            %} 

    </div>
    <div class="google_review_block">
            <div class="google_review">
               {{ logo | image_url: width: 500 | image_tag:
                    alt: shop.name,
                    loading: 'lazy'
                    }}
                <h3>{{ reviews_rating }}</h3>
                <p>{{ reviews_text }}</p>
            </div>
    </div>

                
</div>

{%  style  %}
#shopify-block-{{ block.id }}.block-title {
    /* --block_width: {{block_width}}; */
    --block_width:calc({{block_width}} - var(--gap_horizontal)/2);
    --block_width_phone:{{block_width_phone}};
    --title_max_width: {{title_max_width}}px;
    --title_margin_bottom:{{title_margin_bottom}}px;
    --content_max_width: {{content_max_width}}px;
    --block_padding_horizontal: {{block_padding_horizontal}}px;
    --block_padding_vertical: {{block_padding_vertical}}px;
}

{% endstyle %}


{% schema %}
{
  "name": "Review Title",
  "class": "block-title review-title",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub Title Here",
      "default": "sub title"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Single Title",
      "default": "Single Title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>"
    },
    {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text",
        "default":"BEKIJK VACATURE"
    },
    {
        "type": "url",
        "id": "btn_url",
        "label": "Button Link"
    },
     {
        "type": "select",
        "id": "button_style",
        "label": "Button Style",
        "options": [
            { "value": "filled","label": "Filled" },
            { "value": "outline","label": "Outline" },
            { "value": "linked","label": "Linked" }
            

        ]
    },
    {
        "type": "header",
        "content": "Google Reviews"
    },
    {
        "type": "image_picker",
        "id": "logo",
        "label": "Google Logo"
    },
    {
        "type": "inline_richtext",
        "id": "reviews_text",
        "label": "Reviews Text",
        "default": "Gebaseerd op 175+ reviews"
    },
    {
      "type": "range",
      "id": "reviews_rating",
      "label": "Reviews Rating",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 4.5,
      "unit": "px"
    },
    {
        "type": "header",
        "content": "style"
    },
    {
        "type": "select",
        "id": "block_width",
        "label": "Block width",
        "options": [
            { "value": "20%","label": "20%" },
            { "value": "25%","label": "25%" },
            { "value": "33.33%","label": "33.33%" },
            { "value": "40%","label": "40%" },
            { "value": "50%","label": "50%" },
            { "value": "60%","label": "60%" },
            { "value": "66.66%","label": "66.66%" },
            { "value": "75%","label": "75%" },
            { "value": "80%","label": "80%" },
            { "value": "100%","label": "100%" }
            

        ],
        "default":"50%"
    },
    
      {
        "type": "range",
        "id": "block_padding_horizontal",
        "label": "Block Padding Horizontal",
        "max": 150,
        "min": 0,
        "step": 5,
        "default":30,
        "unit": "px"
    },
     {
        "type": "range",
        "id": "block_padding_vertical",
        "label": "Block Padding Vertical",
        "max": 150,
        "min": 0,
        "step": 5,
        "default":30,
        "unit": "px"
    },
    {
        "type": "range",
        "id": "title_max_width",
        "label": "Title Max width",
        "max": 900,
        "min":200,
        "step": 10,
        "default":500,
        "unit": "px"
    },
    {
        "type": "range",
        "id": "content_max_width",
        "label": "Content Max width",
        "max": 900,
        "min":200,
        "step": 10,
        "default":500,
        "unit": "px"
    },
     {
        "type": "select",
        "id": "title_size",
        "label": "Title Size",
        "default":"large",
        "options": [
            {"label": "Small", "value": "small"},
            {"label": "Medium", "value": "medium"},
            {"label": "Large", "value": "large"},
            {"label": "Extra Large", "value": "extralarge"},
            {"label": "Extra Extra Large", "value": "extraextralarge"}
        ]
    },
    {
        "type": "range",
        "id": "title_margin_bottom",
        "label": "Title Margin Bottom",
        "max": 100,
        "min":0,
        "step": 1,
        "default":30,
        "unit": "px"
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "settings.color_scheme",
        "default": "scheme-1"
    },
    {
        "type": "header",
        "content": "Mobile Responsive"
    },
     {
        "type": "select",
        "id": "block_width_phone",
        "label": "Block width Phone",
        "options": [
            { "value": "20%","label": "20%" },
            { "value": "25%","label": "25%" },
            { "value": "33.33%","label": "33.33%" },
            { "value": "40%","label": "40%" },
            { "value": "50%","label": "50%" },
            { "value": "60%","label": "60%" },
            { "value": "66.66%","label": "66.66%" },
            { "value": "75%","label": "75%" },
            { "value": "80%","label": "80%" },
            { "value": "100%","label": "100%" }
            

        ],
        "default":"100%"
    }
   

    ],
  "presets": [
    {
      "name": "Reviews Title"
      
    }
       
  ]
}
{% endschema %}

{%  stylesheet  %} 

.block-title {

    flex-basis:var(--block_width);
    max-width:var(--block_width);
    @media screen and (max-width:767px) {
       flex-basis:var(--block_width_phone);
      max-width:var(--block_width_phone); 
    }

}

.block-title  .title_style {
    padding:var(--block_padding_vertical) var(--block_padding_horizontal);
}
.block-title h5 {
    color:rgb(var(--color-shadow));
    text-transform: uppercase;
    margin-bottom: 10px;
    font-size: 25px;

}
.block-title h2 {
    max-width: var(--title_max_width);
    margin-bottom: var(--title_margin_bottom);
    
}

.block-title .content {
   max-width: var(--content_max_width); 
}

.review-title .title_style {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;

    .google_review_block {
      .google_review{
            display: flex;
    align-items: center;
    gap: 28px;
    border: 3px solid #3C5358;
    padding: 25px 30px;
    border-radius: 25px;
        img {
            width:57px;
            height:58px;
        }
        h3 {
            
            font-weight: 600;
            font-size: 80px;
            line-height: 120%;
            letter-spacing: 0%;

        }
        p {
            
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 12px;
            line-height: 120%;
            letter-spacing: 0%;
            opacity:50%;
            color:#fff;

            strong {
                opacity:100%;
                color:#fff;
            }
        }
      }  
    }
}

@media (max-width:749px) {
  .review-title .title_style {
    flex-direction:column;
    align-items: flex-start;
}  
}
{% endstylesheet %}