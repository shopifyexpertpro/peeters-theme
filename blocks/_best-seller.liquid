
{%  liquid 
assign image = block.settings.image
assign title = block.settings.title
assign link = block.settings.link


%}



<div class="best_seller">
    {%  render 'media' , media:image %}
    <h3>
    {% if link != blank %}
   <a href="{{ link }}" class="btn"> {{ title }}  {% render 'right-arrow' %} </a>
    {%  else %}
      {{ title }}
    {% endif %}
    </h3>
</div>


{%  schema  %} 
{
    "class": "swiper-slide",
    "name": "Best Seller",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default":" DUTCH ID FLOW"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Url"
        },
        {
            "type": "header",
            "content": "Feature"
        },
        {
            "type": "text",
            "id": "feature_01",
            "label": "Feature 01",
            "default":"Bosch Active Line Plus"
        },
        {
            "type": "text",
            "id": "info_01",
            "label": "Info 01",
            "default":"MOTOR"
        },
        {
            "type": "text",
            "id": "feature_02",
            "label": "Feature 02",
            "default":"Bosch 400 Wh inbegrepen"
        },
        {
            "type": "text",
            "id": "info_02",
            "label": "Info 02",
            "default":"ACCU"
        },
        {
            "type": "text",
            "id": "feature_03",
            "label": "Feature 03",
            "default":"Bosch Purion LCD"
        },
        {
            "type": "text",
            "id": "info_03",
            "label": "Info 03",
            "default":"DISPLAY"
        }
      
    ],
    "presets": [
        {
        "name": "Best seller"
        }
    ]
}

{% endschema %}