{{ 'advisor-section.css' | asset_url | stylesheet_tag }}

{%  capture children %} 
 {% content_for 'blocks' %}
{% endcapture %} 

{%  render 'advisor-section', section:section, children :children  %} 


{%  schema  %} 
    {
        "name": "Advisor Section",
        "class": "advisor-section",
        "tag": "section",
        "blocks": [
            {
                "type": "@theme"
            }
        ],
        "settings": [
            {
                "type": "header",
                "content": "Section Style"
            },
            {
                "type": "text",
                "id": "layout_max_width",
                "label": "Layout Max Width",
                "default":"1603px"
            },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "settings.color_scheme",
                "default": "scheme-1"
            },
            {
                "type": "select",
                "default":"center",
                "id": "alignment",
                "label": "Block Alignment",
                "options": [
                    {"value": "flex-start", "label":"Top"},
                    {"value": "center", "label":"Center"},
                    {"value": "flex-end", "label":"Bottom"},
                ]

            },
           
            {
                "type": "range",
                "id": "padding_top",
                "label": "Padding Top",
                "max": 100,
                "min": 0,
                "step": 5,
                "default":20,
                "unit": "px"
            },
             {
                "type": "range",
                "id": "padding_bottom",
                "label": "Padding Bottom",
                "max": 100,
                "min": 0,
                "step": 5,
                "default":20,
                "unit": "px"
            },
            {
                "type": "range",
                "id": "gap_horizontal",
                "label": "Column Gap Horizontal",
                "max": 100,
                "min": 0,
                "step": 5,
                "default":20,
                "unit": "px"
            },
           {
                "type": "range",
                "id": "gap_vertical",
                "label": "Column Gap Vertical",
                "max": 100,
                "min": 0,
                "step": 5,
                "default":20,
                "unit": "px"
            },
            {
      "type": "header",
      "content": "Mobile Responsive"
    },
    {
      "type": "select",
      "id": "flex_direction",
      "label": "Block Direction",
      "options": [
        {"value": "row" , "label": "Row"},
        {"value": "row-reverse" , "label": "Row Reverse"},
        {"value": "column" , "label": "Column"},
        {"value": "column-reverse" , "label": "Column Reverse"},
        

      ],
      "default": "column"
      
      
        },
        {
        "type": "range",
        "id": "padding_top_phone",
        "label": "Padding Top",
        "min": 0,
        "max": 500,
        "step": 5,
        "default": 50,
        "unit": "px"
        },
        {
        "type": "range",
        "id": "padding_bottom_phone",
        "label": "Padding Bottom",
        "min": 0,
        "max": 500,
        "step": 5,
        "default":50,
        "unit": "px"
        }
            ],
        "presets": [
            {
            "name": "Advisor Section"
        }]
    }
{% endschema %} 
