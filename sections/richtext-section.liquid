
{{ 'richtext-section.css' | asset_url | stylesheet_tag }}



{%  liquid 
    assign layout_max_width = section.settings.layout_max_width
    assign block_align = section.settings.block_align
    assign block_horizontal_align = section.settings.block_horizontal_align
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom

    assign  background_color = section.settings.background_color 

    assign radius_top_left = section.settings.radius_top_left
    assign radius_top_right = section.settings.radius_top_right
    assign radius_bottom_left = section.settings.radius_bottom_left
    assign radius_bottom_right = section.settings.radius_bottom_right


    assign gap_horizontal = section.settings.gap_horizontal
    assign gap_vertical = section.settings.gap_vertical

    assign flex_direction = section.settings.flex_direction
    assign padding_top_phone = section.settings.padding_top_phone
    assign padding_bottom_phone = section.settings.padding_bottom_phone
   

%} 
{%  style  %}
#shopify-section-{{ section.id }} {
--max-width:{{layout_max_width}};
--block_align:{{block_align}};
--block_horizontal_align:{{block_horizontal_align}};
--padding_top:{{padding_top}}px;
--background_color:{{background_color}};
--padding_bottom:{{padding_bottom}}px;
--radius_top_left:{{radius_top_left }}px;
--radius_top_right:{{radius_top_right}}px;
--radius_bottom_left:{{radius_bottom_left}}px;
--radius_bottom_right:{{radius_bottom_right}}px;


--flex_direction:{{flex_direction}};
--padding_top_phone:{{padding_top_phone}}px;
--padding_bottom_phone:{{padding_bottom_phone}}px;

background-color: var(--background_color);
position:relative;


}

{% endstyle %}



<section class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
    
        <div class="flex">
             {% content_for 'blocks' %}
        </div>
        
    </div>
</section>


{% schema %}
{
  "name": "Richtext Section",
  "class": "richtext-section",
  "tag": "section",
  "blocks": [
    {
      "type": "title"
    },
     {
      "type": "media"
    },
    {
      "type": "content"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Style"
    },
    {
      "type": "text",
      "id": "layout_max_width",
      "label": "Layout Max Width",
      "default": "1603px"
    },
    {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#06123D"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "block_align",
      "label": "Block Alignment",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "block_horizontal_align",
      "label": "Horizontal Alignment",
      "default": "flex-start",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        },
        {
          "value": "space-between",
          "label": "Space Between"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "Column Gap Horizontal",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "Column Gap Vertical",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
        "type": "header",
        "content": "Section Radius"
    },
    {
      "type": "range",
      "id": "radius_top_left",
      "label": "Radius Top Left",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius_top_right",
      "label": "Radius Top Right",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius_bottom_left",
      "label": "Radius Bottom Left",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 250,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius_bottom_right",
      "label": "Radius Bottom Right",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile Responsive"
    },
    {
      "type": "select",
      "id": "flex_direction",
      "label": "Block Direction",
      "options": [
        {"value": "row" , "label": "Row"},
        {"value": "row-reverse" , "label": "Row Reverse"},
        {"value": "column" , "label": "Column"},
        {"value": "column-reverse" , "label": "Column Reverse"},
        

      ],
      "default": "column"
      
      
    },
     {
      "type": "range",
      "id": "padding_top_phone",
      "label": "Padding Top",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_phone",
      "label": "Padding Bottom",
      "min": 0,
      "max": 500,
      "step": 5,
      "default":50,
      "unit": "px"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Richtext Section"
    }
  ]
}
{% endschema %}